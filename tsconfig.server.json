{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "outDir": "dist/server", "rootDir": "src",
    "types": ["node"], "sourceMap": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["**/__tests__/**", "**/test-utils/**"]
}
