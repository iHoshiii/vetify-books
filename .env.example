NODE_ENV=development
PORT=8102
MONGODB_URI=mongodb://127.0.0.1:27017/vetify_books
MAIN_AUTH_ORIGIN=http://localhost:8000
AUTH_CLIENT_ID=vetify-books
AUTH_CALLBACK_URL=http://localhost:5175/auth/callback
CLIENT_ORIGIN=http://localhost:5175
BLOB_STORE_ID=<private_books_blob_store_id>
# Use Vercel project OIDC in production. Set a private store token only for local Blob testing.
# BLOB_READ_WRITE_TOKEN=
# Set CRON_SECRET in Vercel for authenticated daily screening and retention.
# CRON_SECRET=<random_at_least_32_characters>
GEMINI_API_KEY=<books_screening_key_if_required>
VITE_API_URL=/api/v1
BOOKS_STORAGE=local
LOCAL_STORAGE_DIR=.data/pdfs
LOCAL_STORAGE_SECRET=<random_at_least_32_characters>
SESSION_ENCRYPTION_KEY=<random_32_bytes_as_64_hex_characters>
MAIN_AUTH_SERVICE_TOKEN=<books_only_capability_service_credential>
GEMINI_BOOK_MODEL=gemini-3.5-flash
