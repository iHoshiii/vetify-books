NODE_ENV=production
MONGODB_URI=mongodb+srv://<books_username>:<url_encoded_password>@<cluster_hostname>/vetify_books?retryWrites=true&w=majority
MONGODB_DATABASE=vetify_books
MAIN_AUTH_ORIGIN=https://<main_app_hostname>
AUTH_CLIENT_ID=vetify-books
AUTH_CALLBACK_URL=https://books.vetify.page/auth/callback
CLIENT_ORIGIN=https://books.vetify.page
BOOKS_STORAGE=vercel-blob
BLOB_STORE_ID=<private_books_blob_store_id>
SESSION_ENCRYPTION_KEY=<random_32_bytes_as_64_hex_characters>
MAIN_AUTH_SERVICE_TOKEN=<books_only_capability_service_credential_from_main>
CRON_SECRET=<separate_random_secret_at_least_32_characters>
GEMINI_API_KEY=<books_only_google_ai_studio_api_key>
GEMINI_BOOK_MODEL=gemini-3.5-flash
VITE_API_URL=/api/v1
