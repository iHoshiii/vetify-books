{
  "name": "vetify-books",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n client,api,worker \"npm:dev:client\" \"npm:dev:server\" \"npm:dev:worker\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p tsconfig.vercel.json",
    "lint": "npm run typecheck && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "node scripts/smoke-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5175",
    "start": "node dist/server/server/index.js",
    "worker": "node dist/server/server/worker.js",
    "worker:once": "node dist/server/server/worker.js --once",
    "evaluate:screening": "tsx scripts/evaluate-book-screening.ts"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/blob": "^2.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.21.0",
    "mongodb": "^7.5.0",
    "oauth4webapi": "^3.8.0",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.4",
    "jsdom": "^25.0.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
